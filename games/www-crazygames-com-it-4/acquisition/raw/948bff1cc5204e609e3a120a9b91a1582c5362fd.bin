    <body ondragstart="return false;" ondrop="return false;">
	<div style="position: fixed; background-color: transparent; top: 0px; left: 0px; width: 100%; height: 100%"></div>
          <script>
            document.addEventListener("DOMContentLoaded", () =>{
                    var oMain = new CMain({
                        fullscreen:false,        //SET THIS TO FALSE IF YOU DON'T WANT TO SHOW FULLSCREEN BUTTON
                        
                        playerIO_ID: "ultimate-tic-tac-toe-ekj3kvuluuwzc3ncddk4fq",                //PLAYERIO GAME ID: CRAZYGAMES REPLACES IT WITH ITS OWN
                        
                    });

                    document.addEventListener("end_game", function(evt,iWinner) {
                            //-1 => DRAW
                            //0 => WIN PLAYER 1
                            //1 => WIN PLAYER 2 OR CPU
                            var iWinnerID = evt.detail.winner_id;
                    });

                    document.addEventListener("start_session", (evt) => {

                    });

                    document.addEventListener("end_session", (evt) => {

                    });

                    document.addEventListener("save_score",  (evt) => {
                        var iScore = evt.detail.score;
                    });
                    
                    document.addEventListener("show_interlevel_ad", (evt) => {

                    });
        
                     if (isIOS()) {
                        setTimeout(function () {
                            sizeHandler();
                        }, 200);
                    } else {
                        sizeHandler();
                    }
           });


        </script>
        
